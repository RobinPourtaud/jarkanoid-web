{
  "name": "jarkanoid-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node tools/build_offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "setup:assets": "python3 tools/setup_assets.py",
    "test:browser": "playwright test",
    "test:offline": "npm run build && playwright test --config playwright.offline.config.ts",
    "analyze": ".venv/bin/python tools/inspect_binary.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  }
}
